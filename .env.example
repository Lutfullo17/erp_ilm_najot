# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-at-least-50-characters-long
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database Settings
# DB_NAME=ilm_najot_erp
# DB_USER=erp_user
# DB_PASSWORD=erp_password
# DB_HOST=localhost
# DB_PORT=5432

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCDEF...
TELEGRAM_WEBHOOK_SECRET=some-secret-string

# Other
DJANGO_LOG_LEVEL=INFO
SECURE_SSL_REDIRECT=True

# Xavfsizlik (audit): DEBUG standarti endi False, SECRET_KEY majburiy
# DEBUG=False
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# Proksi (nginx/Heroku/Render) ortida HTTPS bo'lsa:
# USE_PROXY_SSL_HEADER=True
# TRUST_X_FORWARDED_FOR=True
# Administrator to'lov sanasini necha kun orqaga qo'ya oladi:
# PAYMENT_BACKDATE_DAYS=7
# Webhook rejimida majburiy (bo'sh bo'lsa webhook 503 qaytaradi):
# TELEGRAM_WEBHOOK_SECRET=...
# Faqat alohida clock jarayoni scheduler ishlatsin:
# DISABLE_WEB_SCHEDULER=True
